        <skos:prefLabel xml:lang="en">was directed at</skos:prefLabel>
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P15_was_influenced_by"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E70_Thing"/>
        <owl:inverseOf rdf:resource="http://wiss-ki.eu/ontology/default/was_target_of"/>
        <rdfs:comment xml:lang="en">This property describes an activity whose intended aim is the object or its condition, without necessarily modifying it.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://wiss-ki.eu/ontology/default/was_target_of">
        <rdfs:label xml:lang="en">was target of</rdfs:label>
