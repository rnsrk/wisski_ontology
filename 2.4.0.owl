        <skos:notation>was_target_of</skos:notation>
        <skos:prefLabel xml:lang="en">was target of</skos:prefLabel>
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P15i_influenced"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E70_Thing"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <owl:inverseOf rdf:resource="http://wiss-ki.eu/ontology/default/was_directed_at"/>
        <rdfs:comment xml:lang="en">Inverse of was directed at. This property describes a thing that was the intended aim of an activity, without necessarily being modified by it.</rdfs:comment>
    </owl:ObjectProperty>

